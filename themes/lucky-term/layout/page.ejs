<div class="wrap page">
<% if (page.type === 'columns') { %>
  <h1 class="page-title"><span class="ui-term"><span class="c-accent">$</span> cd columns/ &amp;&amp; ls</span><span class="ui-ios">专栏</span></h1>
  <p class="c-muted">建议按编号顺序阅读。读过的文章会记录在本机浏览器里，进度条随之更新。</p>
  <%- partial('_partial/roadmap') %>
  <script type="application/json" id="series-data"><%- series_json() %></script>

<% } else if (page.type === 'series') {
  const s = series_all().find(x => x.key === page.series);
%>
  <% if (!s) { %><p>未找到专栏：<%= page.series %></p><% } else { %>
  <div class="series-head" data-series="<%= s.key %>">
    <div class="post-path"><span class="ui-term"><a href="<%- url_for('/') %>">~</a>/<a href="<%- url_for('/column/') %>">columns</a>/<span class="c-fg"><%= s.key %></span></span><span class="ui-ios"><a href="<%- url_for('/column/') %>">全部专栏</a></span></div>
    <h1 class="page-title"><span class="rm-no"><%= String(s.index).padStart(2, '0') %></span> <%= s.name %></h1>
    <p class="c-muted"><%= s.desc %></p>
    <div class="series-progress">
      <span class="rm-bar" data-bar>[<%= '-'.repeat(20) %>]</span>
      <span>已读 <span data-count>0</span> / <%= s.items.length %> 篇 · 共 <%= s.chapters.length %> 章</span>
    </div>
  </div>
  <% if (page.content && page.content.trim()) { %><div class="md series-note"><%- page.content %></div><% } %>
  <% s.chapters.forEach(function (c) { %>
  <section class="chapter series-chapter">
    <h2 class="chapter-title"><span class="c-accent"><span class="ui-term">ch<%= c.no %></span><span class="ui-ios">第 <%= c.no %> 章</span></span> <%= c.name %> <span class="c-muted chapter-count"><%= c.posts.length %> 篇</span></h2>
    <% if (c.posts.length) { %>
    <ul class="ls-list">
      <% c.posts.forEach(function (it) { %>
      <li class="ls-row" data-read-url="<%- url_for(it.post.path) %>">
        <span class="ls-no"><%= it.no %></span>
        <a class="ls-title" href="<%- url_for(it.post.path) %>"><%= it.post.title %></a>
        <span class="ls-date"><%= date(it.post.date, 'YYYY-MM-DD') %></span>
        <span class="read-mark" title="已读">✓</span>
      </li>
      <% }) %>
    </ul>
    <% } else { %>
    <p class="c-muted empty"><span class="ui-term"># TODO: </span><span class="ui-ios"></span>敬请期待…</p>
    <% } %>
  </section>
  <% }) %>
  <script type="application/json" id="series-data"><%- series_json() %></script>
  <% } %>

<% } else if (page.type === 'tags') { %>
  <h1 class="page-title"><span class="ui-term"><span class="c-accent">$</span> ls tags/ <span class="c-muted">| wc -l → <%= site.tags.length %></span></span><span class="ui-ios">标签 <span class="c-muted"><%= site.tags.length %> 个</span></span></h1>
  <div class="tag-cloud tag-cloud-lg">
    <% site.tags.sort('-length').each(function (t) { %><a href="<%- url_for(t.path) %>"><span class="ui-term">#</span><%= t.name %><sup><%= t.length %></sup></a><% }) %>
  </div>

<% } else if (page.type === 'categories') { %>
  <h1 class="page-title"><span class="ui-term"><span class="c-accent">$</span> tree categories/</span><span class="ui-ios">分类</span></h1>
  <ul class="tree">
    <% site.categories.filter(c => !c.parent).sort('name').each(function (root) {
      const children = site.categories.filter(c => c.parent === root._id).toArray();
    %>
    <li><a href="<%- url_for(root.path) %>"><%= root.name %>/</a> <span class="c-muted"><%= root.length %></span>
      <% if (children.length) { %>
      <ul>
        <% children.forEach(function (c) { %><li><a href="<%- url_for(c.path) %>"><%= c.name %></a> <span class="c-muted"><%= c.length %></span></li><% }) %>
      </ul>
      <% } %>
    </li>
    <% }) %>
  </ul>

<% } else if (page.type === 'essay') {
  const essay = (site.data.essay && site.data.essay[0]) || { essay_list: [] };
%>
  <h1 class="page-title"><span class="ui-term"><span class="c-accent">$</span> cat notice.log</span><span class="ui-ios">公告</span></h1>
  <ul class="log">
    <% essay.essay_list.forEach(function (n) { %>
    <li><span class="c-muted log-date"><span class="ui-term">[</span><%= date(n.date, 'YYYY-MM-DD') %><span class="ui-term">]</span></span> <%= n.content %><% if (n.link) { %> <a href="<%- url_for(n.link) %>">→</a><% } %></li>
    <% }) %>
  </ul>

<% } else if (page.type === 'review') { %>
  <%# 错题本与间隔复习：内容全由 js/review.js 按本机记录画出来 %>
  <div data-review-page>
    <h1 class="page-title"><span class="ui-term"><span class="c-accent">$</span> crontab -l <span class="c-muted"># 今天该复习的</span></span><span class="ui-ios">复习</span></h1>
    <p class="rv-sum" data-rv-sum>&nbsp;</p>
    <section class="rv-sec">
      <h2 class="rv-h"><span class="ui-term">## </span>今天该复习</h2>
      <ul class="rv-list" data-rv-due></ul>
    </section>
    <section class="rv-sec">
      <h2 class="rv-h"><span class="ui-term">## </span>接下来 7 天</h2>
      <ol class="rv-week" data-rv-week></ol>
    </section>
    <section class="rv-sec">
      <h2 class="rv-h"><span class="ui-term">## </span>错题本 <span class="c-muted rv-h-sub">提交过、还没通过的题</span></h2>
      <ul class="rv-list" data-rv-wrong></ul>
    </section>
    <details class="rv-rules">
      <summary>复习是怎么安排的？</summary>
      <p>在刷题里通过一道题，或在文章的代码块里通过一次填空 / 照着敲 / 默写，就开始跟踪它：第二天复习一次，之后依次隔 2、4、7、15、30 天再复习。复习 = 再通过一次（题目重新提交通过，代码块再做一次填空、照着敲或默写）。没到日子提前做不算一轮，过了日子再做也照常往后排。六轮都完成就算掌握，不再提醒。</p>
      <p>记录只保存在这个浏览器里，可以用页脚的「学习记录备份」带到别的浏览器。</p>
    </details>
  </div>
  <script type="application/json" id="posts-data"><%- posts_json() %></script>
  <script type="application/json" id="problems-data"><%- problems_json() %></script>
  <script src="<%- asset_url('/js/review.js') %>"></script>

<% } else if (page.type === '404') { %>
  <div class="nf-ios ui-ios">
    <p class="nf-code">404</p>
    <p class="nf-text">这个页面不存在，可能已经改名或者被删掉了。</p>
    <p class="nf-actions"><a class="btn btn-solid" href="<%- url_for('/') %>">回到首页</a> <button type="button" class="btn" data-search-open>搜索文章</button></p>
  </div>
  <div class="term notfound ui-term">
    <div class="term-bar"><span>bash</span></div>
    <div class="term-body">
      <p class="cmd"><span class="c-accent">$</span> cd <span id="nf-path"></span></p>
      <p class="out c-danger">bash: cd: No such file or directory</p>
      <p class="cmd"><span class="c-accent">$</span> <a href="<%- url_for('/') %>">cd ~</a> <span class="c-muted"># 回到首页，或按 / 搜索</span></p>
    </div>
  </div>
  <script>document.getElementById('nf-path').textContent = decodeURI(location.pathname);</script>

<% } else { %>
  <h1 class="page-title"><%= page.title %></h1>
  <div class="md"><%- page.content %></div>
  <%- partial('_partial/comments') %>
<% } %>
</div>
