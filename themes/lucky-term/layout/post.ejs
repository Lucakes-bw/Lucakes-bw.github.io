<%
  const so = series_of(page);
  const tocHtml = toc(page.content, { list_number: false, max_depth: 3 });
  const url = url_for(page.path);
%>
<article class="wrap post">
  <header class="post-head">
    <div class="post-path">
      <span class="ui-term"><a href="<%- url_for('/') %>">~</a>/<% if (so) { %><a href="<%- url_for(so.series.path) %>">columns/<%= so.series.key %></a>/<%= so.item.chapter %>/<% } else { %>posts/<% } %><span class="c-fg"><%= page.slug %>.md</span></span>
      <span class="ui-ios"><% if (so) { %><a href="<%- url_for(so.series.path) %>"><%= so.series.name %></a> › <%= so.item.chapter %><% } else { %><a href="<%- url_for('/archives/') %>">文章</a><% } %></span>
    </div>
    <h1 class="post-title"><% if (so) { %><span class="post-no"><%= so.item.no %></span><% } %><%= page.title %></h1>
    <div class="post-meta">
      <span><%= config.author %></span>
      <span>发布 <time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY-MM-DD') %></time></span>
      <% if (page.updated && date(page.updated, 'YYYY-MM-DD') !== date(page.date, 'YYYY-MM-DD')) { %><span>更新 <%= date(page.updated, 'YYYY-MM-DD') %></span><% } %>
      <span><%= wordcount(page.content) %> 字</span>
      <span>约 <%= min2read(page.content) %> 分钟</span>
      <% if (theme.busuanzi) { %><span id="busuanzi_container_page_pv" style="display:none">阅读 <span id="busuanzi_value_page_pv"></span></span><% } %>
      <button type="button" class="btn btn-ghost btn-sm focus-btn" data-focus-toggle aria-pressed="false" title="只显示正文（快捷键 F）">专注阅读</button>
    </div>
    <% if (page.tags && page.tags.length) { %>
    <div class="post-tags">
      <% page.tags.each(function (t) { %><a href="<%- url_for(t.path) %>">#<%= t.name %></a><% }) %>
    </div>
    <% } %>
  </header>

  <div class="post-body">
    <div class="post-content md" id="post-content"><%- page.content %></div>
    <% const gl = glossary_json(page.content); if (gl) { %><script type="application/json" id="glossary-data"><%- gl %></script><% } %>
    <% if (tocHtml) { %>
    <aside class="toc" id="toc">
      <div class="toc-title"><span class="ui-term"><span class="c-accent">$</span> grep '^#' <%= page.slug %>.md</span><span class="ui-ios">目录</span></div>
      <%- tocHtml %>
    </aside>
    <%# 窄屏目录的入口与音乐、番茄钟一起放在 layout.ejs 的底部工具栏中。 %>
    <div class="toc-backdrop" data-toc-backdrop hidden></div>
    <% } %>
  </div>

  <footer class="post-end">
    <div class="mark-read" data-mark-read="<%- url %>">
      <span class="mark-text">
        <span class="when-unread"><span class="ui-term"><span class="c-accent">$</span> touch .read</span><span class="ui-ios">读完这一篇了吗？</span></span>
        <span class="when-read"><span class="ui-term"><span class="c-accent">$</span> </span>已读完这一篇 ✓</span>
      </span>
      <button type="button" class="btn btn-solid" data-mark-btn>标记为已读</button>
    </div>

    <% const pbs = problems_for_post(page); if (pbs.length) { %>
    <%# 练一练：用题库里的题巩固本文的知识点；✓ / ○ 来自本机的做题记录（和题库页同一份 lt-pb-state） %>
    <section class="post-problems" aria-label="练一练">
      <div class="pp-head">
        <span class="pp-title-row"><span class="ui-term"><span class="c-accent">$</span> ls problems/</span><span class="ui-ios">练一练</span><span class="c-muted pp-sub">用这 <%= pbs.length %> 道题巩固本文的内容，在浏览器里直接写代码、提交</span></span>
        <span class="pp-count c-muted" data-pp-count hidden></span>
      </div>
      <ul class="pp-list">
        <% pbs.forEach(function (p, i) { %><li<%- i >= 6 ? ' class="pp-more" hidden' : '' %>><a href="<%- url_for('problems/' + p.slug + '/') %>" data-pp="<%= p.slug %>"><span class="pp-state" aria-hidden="true"></span><span class="pp-no"><%= String(p.id).padStart(3, '0') %></span><span class="pp-name"><%= p.title %></span><span class="pp-diff pp-<%= p.difficulty %>"><%= difficulty_name(p.difficulty) %></span></a></li>
        <% }) %>
      </ul>
      <% if (pbs.length > 6) { %><button type="button" class="pp-toggle" data-pp-toggle>展开其余 <%= pbs.length - 6 %> 道 ↓</button><% } %>
    </section>
    <script>
      (function () {
        var st = {};
        try { st = JSON.parse(localStorage.getItem('lt-pb-state')) || {}; } catch (e) {}
        var links = document.querySelectorAll('[data-pp]'), ac = 0;
        Array.prototype.forEach.call(links, function (a) {
          var s = st[a.getAttribute('data-pp')], mark = a.querySelector('.pp-state');
          if (s && s.status === 'ac') { ac++; a.classList.add('is-ac'); mark.textContent = '✓'; a.title = '已通过'; }
          else if (s) { a.classList.add('is-tried'); mark.textContent = '○'; a.title = '尝试过，还没通过'; }
        });
        var c = document.querySelector('[data-pp-count]');
        if (c && ac) { c.hidden = false; c.textContent = '已通过 ' + ac + ' / ' + links.length; }
        var t = document.querySelector('[data-pp-toggle]');
        if (t) t.addEventListener('click', function () {
          Array.prototype.forEach.call(document.querySelectorAll('.pp-more'), function (li) { li.hidden = false; });
          t.remove();
        });
      })();
    </script>
    <% } %>

    <% if (so) { %>
    <nav class="series-nav">
      <% if (so.prev) { %>
      <a class="sn-prev" href="<%- url_for(so.prev.post.path) %>"><span class="c-muted">← 上一篇 <%= so.prev.no %></span><span><%= so.prev.post.title %></span></a>
      <% } else { %><span></span><% } %>
      <a class="sn-up" href="<%- url_for(so.series.path) %>"><span class="c-muted"><span class="ui-term">cd ..</span><span class="ui-ios">专栏</span></span><span><%= so.series.name %> 目录</span></a>
      <% if (so.next) { %>
      <a class="sn-next" href="<%- url_for(so.next.post.path) %>"><span class="c-muted">下一篇 <%= so.next.no %> →</span><span><%= so.next.post.title %></span></a>
      <% } else { %><span></span><% } %>
    </nav>
    <% } %>
  </footer>

  <%- partial('_partial/comments') %>
</article>

<% if (page.content && page.content.indexOf('class="pktview"') >= 0) { %>
<script src="<%- asset_url('/js/pktview.js') %>"></script>
<% } %>
<% if (page.viz) { %>
<% if (page.uml_viz) { %><script src="<%- asset_url('/js/uml.js') %>"></script>
<% } %><script src="<%- asset_url('/js/dsviz.js') %>"></script>
<% [].concat(page.viz).forEach(function (v) { %><script src="<%- url_for('/js/viz/' + v + '.js') %>"></script>
<% }) %>
<% } %>

<% if (has_c_code(page.content)) { %>
<script>
  window.LT_SNIPPET = {
    clang: <%- JSON.stringify(clang_pkg()) %>,
    cppWorker: <%- JSON.stringify(asset_url('/js/judge/cpp-worker.js')) %>,
    wasiWorker: <%- JSON.stringify(asset_url('/js/judge/wasi-worker.js')) %>,
    notebook: <%- JSON.stringify(!!page.notebook) %>
  };
</script>
<script defer src="<%- asset_url('/js/judge/snippet-core.js') %>"></script>
<script defer src="<%- asset_url('/js/judge/ide.js') %>"></script>
<script defer src="<%- asset_url('/js/judge/cpp-complete.js') %>"></script>
<script defer src="<%- asset_url('/js/judge/snippet-type.js') %>"></script>
<script defer src="<%- asset_url('/js/judge/snippet.js') %>"></script>
<% } %>
