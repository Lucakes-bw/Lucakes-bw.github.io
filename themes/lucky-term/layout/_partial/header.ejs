<%
  const cur = page.path.replace(/index\.html$/, '').replace(/\/$/, '');
  // 专栏里的文章算在「专栏」下：导航点亮「专栏」，提示符也显示 ~/column
  const inSeries = is_post() && !!series_of(page);
  // 提示符只显示到第一级目录：完整路径已经在文章的面包屑里了，这里写全只会又长又被截断
  const top = inSeries ? 'column' : decodeURI(cur.split('/')[0] || '');
  const shownPath = top ? '~/' + top : '~';
%>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="<%- url_for('/') %>" title="<%= config.title %>">
      <span class="p-user"><%= theme.prompt.user %>@<%= theme.prompt.host %></span><span class="p-sep">:</span><span class="p-path"><%= shownPath %></span><span class="p-dollar">$</span><span class="cursor" aria-hidden="true"></span>
    </a>
    <nav class="nav" aria-label="主导航">
      <% theme.menu.forEach(function (item) {
        const href = url_for(item.path);
        const active = ('/' + cur + '/').startsWith(item.path) || (inSeries && item.path === '/column/');
      %>
      <a class="nav-item<%= active ? ' is-active' : '' %>" href="<%- href %>"><span class="nav-cmd"><%= item.cmd %></span><%= item.name %></a>
      <% }) %>
    </nav>
    <div class="header-tools">
      <button class="tool-btn search-btn" type="button" data-search-open aria-label="搜索">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span class="search-label">搜索</span><kbd>/</kbd>
      </button>
      <div class="scheme-picker" data-scheme-picker>
        <button class="tool-btn scheme-btn" type="button" data-scheme-toggle aria-haspopup="listbox" aria-expanded="false" aria-label="切换配色" title="切换配色">
          <svg class="i-palette" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M12 3a9 9 0 1 0 0 18c1.1 0 1.8-.8 1.8-1.8 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-1 .8-1.8 1.8-1.8H16a5 5 0 0 0 5-5c0-3.9-4-7-9-7z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
            <circle cx="7.5" cy="11.5" r="1.6"/><circle cx="9.8" cy="7.3" r="1.6"/><circle cx="14.3" cy="7.3" r="1.6"/><circle cx="16.8" cy="11" r="1.6"/>
          </svg>
        </button>
        <div class="scheme-menu" data-scheme-menu hidden>
          <div class="scheme-menu-head"><span class="ui-term"><span class="c-accent">$</span> theme --list</span><span class="ui-ios">外观</span></div>
          <%# 风格和配色互不影响：iOS 布局也可以配 Nord、Dracula 等任意颜色 %>
          <div class="ui-switch">
            <span class="ui-switch-label">风格</span>
            <div class="seg" role="group" aria-label="界面风格" data-ui-switch>
              <button type="button" data-ui-v="term" aria-pressed="false">终端</button>
              <button type="button" data-ui-v="ios" aria-pressed="false">iOS</button>
            </div>
          </div>
          <div class="ui-switch-label scheme-list-label">配色</div>
          <%
            const allSchemes = (theme.schemes && theme.schemes.list) || [];
            const featuredIds = (theme.schemes && theme.schemes.featured) || [];
            const featured = featuredIds.map(id => allSchemes.find(x => x.id === id)).filter(Boolean);
            const extra = featured.length ? allSchemes.filter(x => !featuredIds.includes(x.id)) : [];
            const ordered = featured.length ? featured.concat(extra) : allSchemes;
          %>
          <ul class="scheme-list<%= extra.length ? ' is-collapsed' : '' %>" role="listbox" aria-label="配色方案" tabindex="-1">
            <% ordered.forEach(function (s, i) { const isExtra = featured.length && i >= featured.length; %>
            <% if (isExtra && i === featured.length) { %><li class="scheme-more" role="presentation"><button type="button" data-scheme-more>更多配色 <span class="c-muted"><%= extra.length %></span></button></li><% } %>
            <li class="scheme-item<%= isExtra ? ' is-extra' : '' %>" role="option" aria-selected="false" data-scheme-id="<%= s.id %>">
              <span class="scheme-swatch" data-scheme="<%= s.id %>" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
              <span class="scheme-name"><%= s.name %></span>
              <span class="scheme-mode"><%= s.mode %></span>
            </li>
            <% }) %>
          </ul>
          <div class="scheme-menu-hint c-muted">↑ ↓ 预览 · Enter 应用 · Esc 取消</div>
        </div>
      </div>
    </div>
  </div>
</header>
