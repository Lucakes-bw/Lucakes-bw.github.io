<%
  const cur = page.path.replace(/index\.html$/, '').replace(/\/$/, '');
  const shownPath = cur ? '~/' + decodeURI(cur) : '~';
%>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="<%- url_for('/') %>" title="<%= config.title %>">
      <span class="p-user"><%= theme.prompt.user %>@<%= theme.prompt.host %></span><span class="p-sep">:</span><span class="p-path"><%= shownPath %></span><span class="p-dollar">$</span><span class="cursor" aria-hidden="true"></span>
    </a>
    <nav class="nav" aria-label="主导航">
      <% theme.menu.forEach(function (item) {
        const href = url_for(item.path);
        const active = ('/' + cur + '/').startsWith(item.path);
      %>
      <a class="nav-item<%= active ? ' is-active' : '' %>" href="<%- href %>"><span class="nav-cmd"><%= item.cmd %></span><%= item.name %></a>
      <% }) %>
    </nav>
    <div class="header-tools">
      <button class="tool-btn search-btn" type="button" data-search-open aria-label="搜索">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span class="search-label">搜索</span><kbd>/</kbd>
      </button>
      <div class="scheme-picker" data-scheme-picker>
        <button class="tool-btn scheme-btn" type="button" data-scheme-toggle aria-haspopup="listbox" aria-expanded="false" aria-label="切换配色">
          <span class="scheme-swatch" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span class="scheme-label"><span class="c-muted">theme:</span><span data-scheme-current></span></span>
        </button>
        <div class="scheme-menu" data-scheme-menu hidden>
          <div class="scheme-menu-head"><span class="c-accent">$</span> theme --list</div>
          <ul class="scheme-list" role="listbox" aria-label="配色方案" tabindex="-1">
            <% ((theme.schemes && theme.schemes.list) || []).forEach(function (s) { %>
            <li class="scheme-item" role="option" aria-selected="false" data-scheme-id="<%= s.id %>">
              <span class="scheme-swatch" data-scheme="<%= s.id %>" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
              <span class="scheme-name"><%= s.name %></span>
              <span class="scheme-mode"><%= s.mode %></span>
            </li>
            <% }) %>
          </ul>
          <div class="scheme-menu-hint c-muted">↑ ↓ 预览 · Enter 应用 · Esc 取消</div>
        </div>
      </div>
    </div>
  </div>
</header>
