<%
  let title = config.title + (config.subtitle ? ' - ' + config.subtitle : '');
  if (page.title) title = page.title + ' | ' + config.title;
  else if (is_category()) title = page.category + ' | ' + config.title;
  else if (is_tag()) title = '#' + page.tag + ' | ' + config.title;
  else if (is_archive()) title = '归档 | ' + config.title;
  const desc = page.description || config.description;
%>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <meta name="description" content="<%= desc %>">
  <% if (config.keywords) { %><meta name="keywords" content="<%= config.keywords %>"><% } %>
  <meta name="author" content="<%= config.author %>">
  <link rel="icon" href="<%- url_for(theme.favicon) %>" type="image/svg+xml">
  <link rel="canonical" href="<%- full_url_for(page.path.replace(/index\.html$/, '')) %>">
  <meta name="theme-color" content="#0e1116">
  <script>
    (function () {
      var t;
      try { t = localStorage.getItem('lt-theme'); } catch (e) {}
      if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', t);
    })();
    window.LT = { root: <%- JSON.stringify(config.root) %>, search: <%- JSON.stringify(url_for((config.search && config.search.path) || 'search.xml')) %> };
  </script>
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/jetbrains-mono@5.1.0/400.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/jetbrains-mono@5.1.0/700.css">
  <link rel="stylesheet" href="<%- url_for('/css/style.css') %>">
</head>
