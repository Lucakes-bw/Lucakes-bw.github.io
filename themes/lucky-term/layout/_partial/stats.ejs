<%# 首页统计面板：数据只在读者自己的浏览器里，由 main.js 计算并填充 %>
<section class="term stats" data-stats hidden>
  <div class="term-bar"><span>stats — 只保存在你的浏览器里</span><span class="c-muted">~/.read_history</span></div>
  <div class="stats-body">
    <div class="stats-head">
      <div class="seg" role="tablist" aria-label="统计类别" data-stats-tabs></div>
      <div class="seg" role="group" aria-label="时间范围" data-stats-range>
        <button type="button" data-range="all" aria-pressed="true">全部</button>
        <button type="button" data-range="30" aria-pressed="false">30 天</button>
        <button type="button" data-range="7" aria-pressed="false">7 天</button>
      </div>
    </div>
    <dl class="stat-tiles" data-stat-tiles></dl>
    <div class="heatmap" data-heatmap role="img"></div>
    <div class="stats-foot">
      <p class="stats-note" data-stats-note></p>
      <span class="heat-legend" aria-hidden="true">少<i class="l0"></i><i class="l1"></i><i class="l2"></i><i class="l3"></i><i class="l4"></i>多</span>
    </div>
  </div>
  <script type="application/json" id="posts-data"><%- posts_json() %></script>
</section>
