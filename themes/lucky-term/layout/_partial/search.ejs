<div class="search-modal" id="search-modal" hidden>
  <div class="search-backdrop" data-search-close></div>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="搜索文章">
    <div class="search-input-row">
      <span class="c-accent">$ grep -ri</span>
      <input id="search-input" type="search" placeholder="指针 / TCP / gcc …" autocomplete="off" spellcheck="false">
      <kbd data-search-close>Esc</kbd>
    </div>
    <ul class="search-results" id="search-results"></ul>
    <div class="search-hint c-muted">↑ ↓ 选择 · Enter 打开 · Esc 关闭 · 输入 <span class="c-accent">theme</span> 切换配色</div>
  </div>
</div>
