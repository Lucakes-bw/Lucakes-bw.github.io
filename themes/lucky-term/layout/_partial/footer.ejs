<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-line ui-term"><span class="c-accent">$</span> uptime</div>
    <div class="footer-line c-muted">
      © <%= theme.since %><%= new Date().getFullYear() > theme.since ? ' - ' + new Date().getFullYear() : '' %> <%= config.author %>
      · <%= site.posts.length %> 篇文章 · <%= totalcount(site) %> 字
      <% if (theme.busuanzi) { %>
      <%# 不蒜子加载成功后才会把 container 显示出来，失败时整段隐藏 %>
      <span id="busuanzi_container_site_pv" style="display:none">· 访问 <span id="busuanzi_value_site_pv"></span> 次</span>
      <span id="busuanzi_container_site_uv" style="display:none">· 访客 <span id="busuanzi_value_site_uv"></span> 人</span>
      <% } %>
    </div>
    <div class="footer-line c-muted">
      Powered by <a href="https://hexo.io" target="_blank" rel="noopener">Hexo</a>
      · Theme lucky-term
      <% if (theme.github) { %>· <a href="<%- theme.github %>" target="_blank" rel="noopener">GitHub</a><% } %>
      · <a href="<%- url_for('/atom.xml') %>">RSS 订阅</a>
      · <a href="#" data-backup-open>学习记录备份</a>
    </div>
  </div>
</footer>
<%# 学习记录备份：逻辑在 js/backup.js，第一次打开时由 main.js 加载 %>
<dialog class="backup-dialog" id="backup-dialog" data-src="<%- asset_url('/js/backup.js') %>" aria-labelledby="backup-title">
  <form method="dialog" class="bk-close-row"><button class="bk-x" aria-label="关闭">×</button></form>
  <h2 id="backup-title"><span class="ui-term"><span class="c-accent">$</span> tar czf progress.json ~/.lucky</span><span class="ui-ios">学习记录备份</span></h2>
  <p class="bk-desc">已读、做题、跟练的记录和草稿都只存在这个浏览器里。导出成文件，换浏览器或设备后再导入；导入是合并，不会覆盖本机已有的记录。</p>
  <p class="bk-stats"><span class="c-muted">本机：</span><span data-bk-stats>…</span></p>
  <div class="bk-actions">
    <button type="button" class="btn btn-solid" data-bk-export>导出到文件</button>
    <button type="button" class="btn" data-bk-import>从文件导入…</button>
    <input type="file" accept=".json,application/json" data-bk-file hidden>
  </div>
  <p class="bk-msg" data-bk-msg role="status" hidden></p>
</dialog>
